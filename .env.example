# Smart QR Restaurant — Environment Variables টেমপ্লেট
# ⚠️ এই ফাইলে কোনো আসল পাসওয়ার্ড রাখবেন না! এটা শুধু টেমপ্লেট।
# লোকালে চালাতে: এই ফাইল কপি করে `.env` বানান → আসল মান বসান।
# Vercel-এ: Project → Settings → Environment Variables-এ একই নাম-মান যোগ করুন।

# 🔴 আবশ্যক — TiDB Cloud (MySQL) কানেকশন স্ট্রিং
# শেষে ?sslaccept=strict অবশ্যই থাকবে; Vercel-এ &connection_limit=1 যোগ করুন
DATABASE_URL="mysql://USERNAME:PASSWORD@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/YOUR_DB_NAME?sslaccept=strict&connection_limit=1"

# 🟠 দৃঢ়ভাবে পরামর্শ — সেশন কুকি সাইন করার গোপন চাবি (৪৮+ র‍্যান্ডম অক্ষর)
SESSION_SECRET="change-me-to-48-random-characters-xxxxxxxxxxxxxxxx"

# 🟠 দৃঢ়ভাবে পরামর্শ — /admin প্যানেলের পাসকোড (ডিফল্ট admin123 রাখবেন না!)
ADMIN_PASSCODE="change-me"

# 🔵 ঐচ্ছিক — মেনুর ছবি আপলোডের ImgBB API কি (কমা দিয়ে একাধিক = অটো-ফেইলওভার)
IMGBB_KEYS=""

# 🔵 ঐচ্ছিক — জন্মদিন অটোমেশন ক্রন-জবের সুরক্ষা চাবি (র‍্যান্ডম লেখা)
CRON_SECRET=""

# 🔵 ঐচ্ছিক — Facebook Messenger CRM (জন্মদিন/অকেশন অফার ইনবক্সে পাঠাতে)
META_PAGE_ID=""
META_PAGE_TOKEN=""
META_VERIFY_TOKEN=""

# 🔵 ঐচ্ছিক — AI চ্যাটবটের Gemini API কি (admin প্যানেলের সেটিংস থেকেই কি যোগ করা যায় —
# সেখানে একাধিক কি রাখা যায়; এখানে একটি দিলেও চলবে)
GEMINI_API_KEY=""
